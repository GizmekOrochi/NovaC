fn factorial(n) {
    if n <= 1 {
        give 1;
    }

    give n * factorial(n - 1);
}

fn start() {
    var sum = 0;

    for(i = 0; i < 5; i = i + 1) {
        sum = sum + i;
    }

    print("factorial(5) =");
    print(factorial(5));
    print("sum =");
    print(sum);

    give factorial(5) + sum;
}
